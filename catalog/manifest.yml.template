# Copy this file to the flipper-application-catalog fork as:
# applications/GPIO/marauder_gui/manifest.yml
# Replace COMMIT_SHA_AFTER_PUSH with the full 40-character commit SHA after all source files,
# the license, and qFlipper screenshots have been committed and pushed.
sourcecode:
  type: git
  location:
    origin: https://github.com/mel4mi/Marauder-GUI-Flipper.git
    commit_sha: COMMIT_SHA_AFTER_PUSH
    subdir: marauder_gui

description: "@README.md"
changelog: "@docs/changelog.md"

screenshots:
  - screenshots/main-menu.png
  - screenshots/wifi-menu.png
  - screenshots/wifi-attack-menu.png
  - screenshots/bluetooth-menu.png
  - screenshots/bluetooth-detectors.png
  - screenshots/multi-ap-attack-selection.png
  - screenshots/multi-ap-deauth-attack.png
